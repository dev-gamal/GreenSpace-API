# ==============================================
# GreenSpace Backend - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Server ---
SERVER_PORT=8080

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/greenspace_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=your_jwt_secret_here_use_a_long_hex_string
JWT_EXPIRATION_MS=86400000

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here

# --- MySQL Container ---
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
